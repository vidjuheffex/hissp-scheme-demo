;; Track one actual shader-drawn drop across a mountain weather transition.
(import (scheme base) (scheme python) (srfi 177) (srfi 69)
        (only (world game) blow-precipitation!)
        (world state) (only (world weather) PRECIP-BOX)
        (only pathlib Path)
        (only direct.showbase.ShowBase ShowBase)
        (only panda3d.core ClockObject OrthographicLens PNMImage Shader Vec3 loadPrcFileData)
        (only ursina Mesh))
(include "helpers.scm")

(test-begin "precipitation")
(loadPrcFileData "" "coordinate-system y-up-left\ngl-version 3 2\nwin-size 512 160\naudio-library-name null\nsync-video false")
(define precip-app (call/kw ShowBase (windowType "offscreen")))
(call-method precip-app 'set-background-color 0 0 0)
(define precip-lens (OrthographicLens))
(call-method precip-lens 'set-film-size 4 16)
(call-method precip-lens 'set-near-far 0.1 20)
(call-method (attribute-ref precip-app 'camNode) 'set-lens precip-lens)
(define precip-clock (call-method ClockObject 'get-global-clock))
(define precip-mode (call-method precip-clock 'get-mode))
(call-method precip-clock 'set-mode (attribute-ref ClockObject 'MNonRealTime))
(define precip-drop
  (call/kw Mesh (vertices (vector 0 0 5 0 0 5 0 0 5 0 0 5)
                 triangles (vector 0 1 2 0 2 3)
                 colors (vector 0 0.5 0 1 0 0.5 0 1 0 0.5 0 1 0 0.5 0 1)
                 uvs (vector -1 0 1 0 1 1 -1 1))))
(call-method precip-drop 'reparent-to (attribute-ref precip-app 'render))
(call-method precip-drop 'set-two-sided #t)
(define precip-shaders (call-method (attribute-ref (attribute-ref (call-method (Path __file__) 'resolve) 'parent) 'parent)
                                     'joinpath "src" "shaders"))
(define (precip-source name) (call-method (call-method precip-shaders 'joinpath name) 'read-text))
(call-method precip-drop 'set-shader (call-method Shader 'make (attribute-ref Shader 'SL-GLSL)
                                      (precip-source "precip.vert") (precip-source "precip.frag")))
(call-method precip-drop 'set-shader-input "box" (apply Vec3 PRECIP-BOX))
(call-method precip-drop 'set-shader-input "intensity" 1.0)
(call-method precip-drop 'set-shader-input "ambient_color" (Vec3 1 1 1))
(call-method precip-drop 'set-shader-input "light_color" (Vec3 1 1 1))

;; Measure the luminous rows, then undo the orthographic camera's movement.
(define (drop-height time snow dt x y vx vy)
  (let ((eye (Vec3 x y 0)) (pixels (PNMImage)))
    (call-method precip-clock 'set-frame-time time)
    (call-method (attribute-ref precip-app 'camera) 'set-pos eye)
    (call-method precip-drop 'set-pos eye)
    (call-method precip-drop 'set-shader-input "eye" eye)
    (call-method precip-drop 'set-shader-input "eye_velocity" (Vec3 vx vy 0))
    (call-method precip-drop 'set-shader-input "snow" snow)
    (blow-precipitation! precip-drop 0.0 '(1.0 0.0) snow dt)
    (call-method (attribute-ref precip-app 'graphicsEngine) 'render-frame)
    (call-method (attribute-ref precip-app 'win) 'get-screenshot pixels)
    (let* ((w (call-method pixels 'get-x-size)) (h (call-method pixels 'get-y-size))
           (weight 0.0) (moment 0.0))
      (do ((j 0 (+ j 1))) ((= j h))
        (do ((i 0 (+ i 1))) ((= i w))
          (let ((light (call-method pixels 'get-red i j)))
            (set! weight (+ weight light))
            (set! moment (+ moment (* j light))))))
      (and (> weight 0.0)
           (+ y (* (attribute-ref (call-method precip-lens 'get-film-size) 'y)
                   (- 0.5 (/ (+ 0.5 (/ moment weight)) h))))))))

(define precip-original-drift (state-ref 'precip-drift))
(define precip-original-fall (hash-table-ref/default state 'precip-fall 0.0))
(state-set! 'precip-drift '(0.0 0.0))
(state-set! 'precip-fall 0.0)
(define drop-before (drop-height 96.0 0.0 0.0 0.0 72.0 0.0 0.0))
(define drop-after (drop-height 96.10 0.005 0.10 0.25 72.2 2.5 2.0))
(test-assert "rain keeps falling in world space while climbing into snow after 96 seconds"
             (and drop-before drop-after (< 0.7 (- drop-before drop-after) 1.1)))
;; Resolve the six-centimeter flake over several pixel rows.
(call-method precip-lens 'set-film-size 4 4)
(define flake-before (drop-height 97.0 1.0 0.0 0.25 72.2 0.0 0.0))
(define flake-after (drop-height 97.25 1.0 0.25 -0.5 71.45 -3.0 -3.0))
(test-assert "a snowflake still loses world height when the player runs downhill faster than it falls"
             (and flake-before flake-after (< 0.17 (- flake-before flake-after) 0.43)))
(state-set! 'precip-fall (- (* 20.0 (cadr PRECIP-BOX)) 0.45))
(define wrap-before (drop-height 1000.0 0.0 0.0 0.0 72.0 0.0 0.0))
(define wrap-after (drop-height 1000.1 0.0 0.1 0.0 72.0 0.0 0.0))
(test-assert "wrapping the fall distance preserves a drop's path during long sessions"
             (and wrap-before wrap-after (< 0.7 (- wrap-before wrap-after) 1.1)))
(state-set! 'precip-drift precip-original-drift)
(state-set! 'precip-fall precip-original-fall)
(call-method precip-clock 'set-mode precip-mode)
(call-method precip-app 'destroy)
(test-end "precipitation")
